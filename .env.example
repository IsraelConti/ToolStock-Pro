# Nombres que el servicio y los clientes esperan. Todos los valores van vacíos.
# Copia estos nombres al almacén del proveedor. No rellenes este archivo ni lo subas con datos.

# PostgreSQL. Lo lee server/index.js. Debe empezar por postgres:// o postgresql://.
DATABASE_URL=

# Identificador público del cliente OAuth de escritorio. Lo lee server/index.js y el proceso de PC.
GOOGLE_CLIENT_ID=

# JSON de la cuenta de servicio de Play, en una sola línea. Debe contener client_email y private_key.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# URL https del servicio desplegado. La usan el PC y el build Android. El servidor no la lee.
SYNC_API_BASE=

# Mismo identificador público que GOOGLE_CLIENT_ID. Solo lo lee Gradle, con el nombre GOOGLE_WEB_CLIENT_ID.
# GOOGLE_WEB_CLIENT_ID=

# Opcional. Si queda vacío, el código usa com.icapps.maintenpro.
PLAY_PACKAGE_NAME=

# Opcional. Si queda vacío, el servidor escucha en 8787.
PORT=
